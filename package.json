  "bugs": {
    "url": "https://github.com/Cimpress-MCP/lambda-essentials-ts/issues"
  },
  "homepage": "https://github.com/Cimpress-MCP/lambda-essentials-ts#readme",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1172.0",
    "@aws-sdk/client-secrets-manager": "^3.1172.0",
    "axios": "1.21.1",
    "axios-cache-interceptor": "1.13.0",
    "fast-safe-stringify": "~2.1.1",
    "is-error": "~2.2.2",
    "jsonwebtoken": "9.0.3",
    "md5": "~2.3.0",
    "openapi-factory": "5.4.93",
    "retry-axios": "~4.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/newrelic": "^9.14.8",
    "@types/node": "^26.6.6",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.15.0",
    "eslint-config-cimpress-atsquad": "^3.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "prettier": "eslint-config-cimpress-atsquad/prettier",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
