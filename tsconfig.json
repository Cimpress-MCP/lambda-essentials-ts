{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node", "jest"],
    "strict": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "newLine": "lf",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
